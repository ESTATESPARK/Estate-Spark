    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
        
        :root {
            --navy: #0F172A;
            --gold: #A8864D;
            --danger: #BE123C; /* Institutional Red */
            --slate-200: #E2E8F0;
            --slate-600: #475569;
        }
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background-color: #334155; padding: 40px 0; display: flex; flex-direction: column; align-items: center; }
        .page { width: 210mm; min-height: 297mm; background: white; padding: 60px; box-shadow: 0 25px 50px rgba(0,0,0,0.5); }
        
        header { border-bottom: 4px solid var(--navy); padding-bottom: 30px; margin-bottom: 50px; display: flex; justify-content: space-between; align-items: flex-start; }
        h1 { font-size: 32px; color: var(--navy); margin: 0; text-transform: uppercase; letter-spacing: -1px; }
        
        /* New Status Badge Styling */
        .status-badge {
            background-color: var(--danger);
            color: white;
            font-weight: 800;
            font-size: 14px;
            padding: 8px 20px;
            display: inline-block;
            clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 10px;
        }

        .invoice-meta { text-align: right; font-size: 14px; color: var(--slate-600); }
        h2 { font-size: 18px; background: var(--navy); color: white; padding: 8px 16px; display: inline-block; margin-bottom: 25px; clip-path: polygon(0% 0%, 95% 0%, 100% 50%, 95% 100%, 0% 100%); }
        
        .invoice-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .invoice-table th { background: var(--navy); color: white; text-align: left; padding: 12px; font-size: 12px; text-transform: uppercase; }
        .invoice-table td { padding: 20px 12px; border-bottom: 1px solid var(--slate-200); font-size: 14px; }
        
        .bank-details { margin-top: 40px; padding: 20px; background: #f8fafc; border-left: 4px solid var(--gold); }
        .bank-details h3 { font-size: 14px; margin-top: 0; color: var(--navy); }
        .bank-details p { font-size: 13px; color: var(--slate-600); margin: 5px 0; }
        
        .total-amount { margin-top: 30px; font-size: 28px; font-weight: 800; color: var(--navy); text-align: right; }
        footer { margin-top: 80px; border-top: 1px solid var(--slate-200); padding-top: 20px; font-size: 12px; color: var(--slate-600); text-align: center; }
    </style>
</head>
<body>

